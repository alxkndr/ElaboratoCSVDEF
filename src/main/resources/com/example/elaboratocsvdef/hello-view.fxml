<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" prefHeight="500.0" prefWidth="500.0" spacing="20.0" style="-fx-background-image: image;" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.elaboratocsvdef.HelloController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
   <children>
      <AnchorPane prefHeight="200.0" prefWidth="200.0">
         <children>
            <Button id="mostraCampi" fx:id="mostraCampi" layoutY="2.0" mnemonicParsing="false" onAction="#mostraCampi" style="-fx-background-color: RED;" text="Mostra campi" />
            <TextArea fx:id="textArea" layoutY="146.0" prefHeight="200.0" prefWidth="460.0" />
            <Button id="aggiungiCampo" fx:id="aggiungiCampo" layoutX="107.0" layoutY="2.0" mnemonicParsing="false" onAction="#aggiungiCampo" text="Aggiungi campi" />
            <Button id="generaHTML" fx:id="generaHTML" layoutX="230.0" layoutY="2.0" mnemonicParsing="false" onAction="#generaHTML" text="Crea HTML" />
            <Button id="contaCampi" fx:id="contaCampi" layoutX="345.0" layoutY="2.0" mnemonicParsing="false" onAction="#contaCampi" text="Conta campi" />
         </children>
      </AnchorPane>
   </children>
</VBox>
